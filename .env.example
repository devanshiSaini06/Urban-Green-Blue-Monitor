# Urban Green and Blue Change Monitor - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# GOOGLE EARTH ENGINE
# =============================================================================
# GEE Cloud Project ID
GEE_PROJECT_ID=graphic-tide-513321-m3

# Service account key for deployed backend (JSON format, base64 encoded or file path)
# Option 1: Base64 encoded JSON (recommended for cloud deployment)
# GEE_SERVICE_ACCOUNT_KEY_JSON=<base64_encoded_service_account_json>

# Option 2: File path (for local development with docker-compose)
GEE_SERVICE_ACCOUNT_KEY_PATH="D:\graphic-tide-513321-m3-d1d772c6643c.json"

# =============================================================================
# API SETTINGS
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# CACHE SETTINGS
# =============================================================================
CACHE_DIR=./cache
CACHE_TTL_DAYS=30

# =============================================================================
# FRONTEND SETTINGS
# =============================================================================
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# =============================================================================
# OPTIONAL: REPORT SETTINGS
# =============================================================================
# REPORT_LOGO_PATH=/app/assets/logo.png
# REPORT_FOOTER_TEXT="Urban Green and Blue Change Monitor | Generated {date}"

# =============================================================================
# OPTIONAL: CLOUD DEPLOYMENT (Google Cloud)
# =============================================================================
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_REGION=us-central1
# CLOUD_RUN_SERVICE=ugbcm-backend
# FIREBASE_PROJECT=your-firebase-project